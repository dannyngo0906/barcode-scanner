# Server Configuration
PORT=5000
NODE_ENV=development

# NocoDB Configuration
# URL to your NocoDB database API endpoint
NOCODB_BASE_URL=https://db.salesai.vn/api/v2/tables/m3rrbw0dbrlqogw/records
# NocoDB authentication token (xc-token)
NOCODB_TOKEN=your_nocodb_token_here

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,https://your-production-domain.com

# Database Configuration (Optional - if using Drizzle ORM)
DATABASE_URL=postgresql://user:password@host:port/database
