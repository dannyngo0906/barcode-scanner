# Database Configuration
# PostgreSQL connection string for Neon database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# NocoDB API Configuration (Server-side only - DO NOT expose to client)
# NocoDB base URL for product records API
NOCODB_BASE_URL=https://db.salesai.vn/api/v2/tables/m3rrbw0dbrlqogw/records
# NocoDB API token for authentication
NOCODB_TOKEN=your-secret-token-here

# Server Configuration
# Port for the Express server (default: 5000)
PORT=5000
# Node environment (development, production, test)
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Example: http://localhost:5000,http://localhost:5173,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
